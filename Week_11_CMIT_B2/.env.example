# ShopKaro Serving Environment Variables
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info

# Database & Storage
DUCKDB_PATH=data/processed/shopkaro.duckdb

# Redis Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=3600

# Experimentation & Guardrails
AB_TEST_ENABLED=true
GUARDRAIL_MAX_COMPLAINT_RATE=0.025
