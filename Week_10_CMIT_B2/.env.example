# ==========================================
# ZARYA DIGITAL BANK — ENVIRONMENT CONFIG
# ==========================================

# Server Environment (production / staging / development)
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Database & Storage
DB_PATH=data/zarya_banking.db
RAG_POLICY_FILE=data/rag/zarya_banking_policies.json

# Model Inference Configuration
MODEL_TYPE=gguf_q4km
MODEL_PATH=zarya_qwen2.5_3b_q4km_gguf/
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1

# Security & Compliance Guardrails
ENABLE_GUARDRAILS=true
MASK_PII_LOGS=true
MAX_COMPLAINT_ESCALATION_AMOUNT=50000.0

# Cloud Fallback & LLM-as-a-Judge API Keys (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HUGGING_FACE_TOKEN=your_hf_token_here
