# ==============================================================================
# Pakistan Real Estate AI & MLOps Platform — Environment Configuration
# ==============================================================================

# Server Configuration
ENV=production
HOST=0.0.0.0
PORT=8000
API_WORKERS=2

# Database Configuration (Defaults to SQLite; supports PostgreSQL on Render/RDS)
# SQLite: sqlite:///production_audit.db
# PostgreSQL: postgresql://username:password@dpg-xxxx.render.com/estate_db
DATABASE_URL=sqlite:///production_audit.db

# LLM & AI Assistant API Keys (Optional for LangGraph Assistant)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# MLOps Drift Alert Thresholds
DRIFT_ALERT_MAPE_THRESHOLD=15.0
DRIFT_ALERT_PSI_THRESHOLD=0.25
DRIFT_WARNING_PSI_THRESHOLD=0.10
DRIFT_KS_PVALUE_THRESHOLD=0.05

# Automated Retraining Schedule (Cron expression)
# Default: 0 2 1 * * (Runs 1st of every month at 02:00 AM)
RETRAIN_SCHEDULE_CRON="0 2 1 * *"

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
