CREATE CONSTRAINT contract_id_uniq IF NOT EXISTS FOR (cn:Contract) REQUIRE cn.id IS UNIQUE;
CREATE CONSTRAINT clause_id_uniq IF NOT EXISTS FOR (cl:Clause) REQUIRE cl.id IS UNIQUE;

