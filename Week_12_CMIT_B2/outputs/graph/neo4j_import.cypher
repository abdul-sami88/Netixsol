MERGE (n:Section {id: "sec_stat_010_33"}) ON CREATE SET number: "33", heading: "Parochial and other similar prejudices to be discouraged. The State shall discourage", act_title: "Constitution of the Islamic Republic of Pakistan, 1973", act_id: "act_stat_010", text_preview: "33. Parochial and other similar prejudices to be discouraged. The State shall discourage parochial, racial, tribal, sectarian and provincial prejudices among the citizens.";
