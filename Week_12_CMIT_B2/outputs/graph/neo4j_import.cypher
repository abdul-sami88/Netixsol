MERGE (n:Section {id: "sec_stat_007_44"}) ON CREATE SET number: "44", heading: "Accused persons to be liable to cross-examination.— All accused persons, including an", act_title: "Qanun-e-Shahadat Order, 1984", act_id: "act_stat_007", text_preview: "44. Accused persons to be liable to cross-examination.— All accused persons, including an accomplice, shall be liable to cross-examination.";
