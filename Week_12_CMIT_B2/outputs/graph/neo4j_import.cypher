MERGE (n:Section {id: "sec_stat_007_152"}) ON CREATE SET number: "152", heading: "Questions tending to corroborate evidence of relevant fact admissible.— When a", act_title: "Qanun-e-Shahadat Order, 1984", act_id: "act_stat_007", text_preview: "152. Questions tending to corroborate evidence of relevant fact admissible.— When a witness whom it is intended to corroborate gives evidence of any relevant fact, he may be questioned as to any other";
