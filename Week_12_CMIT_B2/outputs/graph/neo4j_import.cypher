MERGE (n:Section {id: "sec_stat_007_75"}) ON CREATE SET number: "75", heading: "Proof of documents by primary evidence.— Documents must be proved by primary", act_title: "Qanun-e-Shahadat Order, 1984", act_id: "act_stat_007", text_preview: "75. Proof of documents by primary evidence.— Documents must be proved by primary evidence except in the cases hereinafter mentioned.";
